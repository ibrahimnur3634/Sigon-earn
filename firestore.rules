rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn() && request.auth.token.get('admin', false) == true;
    }

    function ownsUser(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function validPhone(phone) {
      return phone is string && phone.matches('^\\+254[17][0-9]{8}$');
    }

    function canReadSurveyQuestions(surveyId) {
      let survey = get(/databases/$(database)/documents/surveys/$(surveyId)).data;
      return survey.active == true
        && (survey.access == 'free'
          || (exists(/databases/$(database)/documents/users/$(request.auth.uid)/paidSurveyAccess/$(surveyId))
            && get(/databases/$(database)/documents/users/$(request.auth.uid)/paidSurveyAccess/$(surveyId)).data.active == true));
    }

    match /users/{userId} {
      allow get: if ownsUser(userId) || isAdmin();
      allow list: if isAdmin();

      allow create: if ownsUser(userId)
        && request.resource.data.keys().hasOnly([
          'uid',
          'fullName',
          'email',
          'phoneNumber',
          'createdAt',
          'accountStatus',
          'role'
        ])
        && request.resource.data.keys().hasAll([
          'uid',
          'fullName',
          'email',
          'phoneNumber',
          'createdAt',
          'accountStatus',
          'role'
        ])
        && request.resource.data.uid == userId
        && request.resource.data.fullName is string
        && request.resource.data.fullName.size() >= 2
        && request.resource.data.fullName.size() <= 100
        && request.resource.data.email == request.auth.token.email
        && validPhone(request.resource.data.phoneNumber)
        && request.resource.data.accountStatus == 'registered'
        && request.resource.data.role == 'user'
        && request.resource.data.createdAt == request.time;

      allow update: if ownsUser(userId)
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['fullName', 'phone', 'phoneNumber', 'updatedAt', 'role'])
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['role'])
          || (!resource.data.keys().hasAny(['role'])
            && request.resource.data.role == 'user'))
        && request.resource.data.fullName is string
        && request.resource.data.fullName.size() >= 2
        && request.resource.data.fullName.size() <= 100
        && (!request.resource.data.keys().hasAny(['phone'])
          || validPhone(request.resource.data.phone))
        && (!request.resource.data.keys().hasAny(['phoneNumber'])
          || validPhone(request.resource.data.phoneNumber))
        && (!request.resource.data.keys().hasAny(['updatedAt'])
          || request.resource.data.updatedAt == request.time);

      allow delete: if false;

      match /paidSurveyAccess/{surveyId} {
        allow read: if ownsUser(userId) || isAdmin();
        allow write: if false;
      }
    }

    match /surveys/{surveyId} {
      allow get, list: if signedIn();
      allow create, update, delete: if false;
    }

    match /surveyQuestions/{questionId} {
      allow get, list: if isAdmin()
        || (signedIn() && canReadSurveyQuestions(resource.data.surveyId));
      allow create, update, delete: if false;
    }

    match /surveySubmissions/{submissionId} {
      allow get, list: if isAdmin() || (signedIn() && resource.data.userId == request.auth.uid);
      allow create, update, delete: if false;
    }

    match /surveyProgress/{progressId} {
      allow read, write: if false;
    }

    match /transactions/{transactionId} {
      allow get, list: if isAdmin() || (signedIn() && resource.data.userId == request.auth.uid);
      allow create, update, delete: if false;
    }

    match /earnings/{earningId} {
      allow get, list: if isAdmin() || (signedIn() && resource.data.userId == request.auth.uid);
      allow create, update, delete: if false;
    }

    match /adminSettings/{settingId} {
      allow read: if isAdmin();
      allow write: if false;
    }
  }
}
